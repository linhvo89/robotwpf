<Window x:Class="WpfCompanyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfCompanyApp.ViewModels"
        xmlns:local="clr-namespace:WpfCompanyApp"
        Title="KBOT"
          Language="en-US"
        Height="900" Width="1700"
        WindowStartupLocation="CenterScreen"  WindowState="Maximized">


    <DockPanel LastChildFill="True" Background="#1E1E1E">
        <!-- 🔷 Thanh tiêu đề -->
        <!-- 🔷 Thanh tiêu đề hiện đại -->
        <Border DockPanel.Dock="Top"
        Height="90"
        Margin="0,0,0,10"
        CornerRadius="0,0,15,15"
        Padding="0">
            <!-- 🎨 Gradient nền tối cao cấp -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C1F26" Offset="0.0"/>
                    <GradientStop Color="#2A3F6F" Offset="0.5"/>
                    <!-- màu trung gian -->
           

                </LinearGradientBrush>

            </Border.Background>

            <!-- ✨ Bóng đổ nhẹ bên dưới -->
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>

            <DockPanel>
                <!-- Logo công ty ở góc trái thanh tiêu đề -->
                <Border DockPanel.Dock="Left"
                        Width="160"
                        Margin="20,8,0,8"
                        Padding="6,3"
                        CornerRadius="8"
                        Background="White"
                        VerticalAlignment="Center">
                    <Image Source="/KBOT;component/Image/NittanVietnamLogo.jpg"
                           Width="145"
                           Height="60"
                           Stretch="Uniform"/>
                </Border>

                <!-- 🔷 Tiêu đề chính -->
                <TextBlock Text="Automatic Pick &amp; Place System"
                   FontSize="42"
                   FontWeight="Bold"
                   Foreground="#E3F2FD"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextOptions.TextFormattingMode="Display">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000"
                                  BlurRadius="8"
                                  ShadowDepth="1"
                                  Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </DockPanel>
        </Border>




        <!-- 🧭 Thanh chuyển tab bên trái -->
        <!-- 🧭 Thanh chuyển tab bên trái -->
        <!-- Sidebar gọn (Width=100) với ToolTip chắc chắn hiện -->
        <Border DockPanel.Dock="Left"
        Width="100"
        Margin="10,0,10,0"
        CornerRadius="10"
        Background="#2D2D2D">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="5">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#50545C" Offset="0"/>
                                    <GradientStop Color="#34373D" Offset="0.55"/>
                                    <GradientStop Color="#292C31" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="#F5F7FA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Margin" Value="0,6,0,6"/>
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="BorderBrush" Value="#6A707A"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Width" Value="80"/>
                        <Setter Property="Height" Value="64"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000"
                                                  BlurRadius="9"
                                                  ShadowDepth="4"
                                                  Direction="270"
                                                  Opacity="0.55"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Border CornerRadius="10"
                                                    BorderBrush="#28FFFFFF"
                                                    BorderThickness="1,1,1,0"/>
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                RecognizesAccessKey="True"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonSurface"
                                                    Property="Background"
                                                    Value="#1976D2"/>
                                            <Setter TargetName="ButtonSurface"
                                                    Property="BorderBrush"
                                                    Value="#64B5F6"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#2196F3"
                                                                      BlurRadius="13"
                                                                      ShadowDepth="3"
                                                                      Direction="270"
                                                                      Opacity="0.62"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonSurface"
                                                    Property="Background"
                                                    Value="#0D47A1"/>
                                            <Setter TargetName="ButtonSurface"
                                                    Property="BorderBrush"
                                                    Value="#42A5F5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="3"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#000000"
                                                                      BlurRadius="4"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.45"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ButtonSurface"
                                                    Property="Opacity"
                                                    Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <!-- Button Home -->
                <Button Command="{Binding GoHomeCommand}" FontSize="20">
                    <!-- bắt buộc dùng element để tooltip chắc chắn -->
                    <Button.ToolTip>
                        <TextBlock Text="Home" Padding="6,2"  FontSize="20"/>
                    </Button.ToolTip>
                    <!-- Tùy chọn: hiện icon + text (nếu muốn) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🏠" FontSize="32" Margin="0,0,4,0"/>
                        <!-- nếu muốn chữ hiển thị trong button, bỏ comment dòng dưới -->
                        <!-- <TextBlock Text="Home" FontSize="13" VerticalAlignment="Center"/> -->
                    </StackPanel>
                </Button>

                <!-- Button Settings -->
                <Button Command="{Binding GoSettingsCommand}" FontSize="20">
                    <ToolTipService.InitialShowDelay>0</ToolTipService.InitialShowDelay>
                    <Button.ToolTip>
                        <TextBlock Text="Settings" Padding="6,2" FontSize="20"/>
                    </Button.ToolTip>
                    <TextBlock Text="⚙️" HorizontalAlignment="Center" FontSize="32" />
                </Button>

                <!-- Button Manual -->
                <Button Command="{Binding GoManualCommand}" FontSize="20">
                    <Button.ToolTip>
                        <TextBlock Text="Manual" Padding="6,2" FontSize="20"/>
                    </Button.ToolTip>
                    <TextBlock Text="📘" FontSize="32" HorizontalAlignment="Center"/>
                </Button>

                <!-- Button Help -->
                <Button x:Name="HelpButton"
                        Click="HelpButton_Click"
                        FontSize="20"
                        Height="68"
                        Padding="6,3">
                    <Button.ToolTip>
                        <TextBlock Text="Help" Padding="6,2" FontSize="20"/>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu FontFamily="Segoe UI"
                                     FontSize="16"
                                     MinWidth="310"
                                     Background="#2D2D2D"
                                     Foreground="White">
                            <MenuItem Header="Mở tài liệu vận hành (PDF)"
                                      Click="OpenOperatingManual_Click"/>
                            <MenuItem Header="Liên hệ và hỗ trợ (kbot.vn)"
                                      Click="OpenCompanyWebsite_Click"/>
                            <Separator/>
                            <MenuItem Header="Thông tin phiên bản"
                                      Click="ShowVersionInfo_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="?"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   LineHeight="26"/>
                        <TextBlock Text="Help"
                                   FontSize="11"
                                   Margin="0,0,0,2"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>



        <!-- 🌌 Khu hiển thị nội dung View -->
        <Border CornerRadius="10" Background="#2D2D2D" Margin="0,0,10,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <ContentControl Content="{Binding NavigationService.CurrentViewModel}" />
        </Border>
    </DockPanel>

</Window>
