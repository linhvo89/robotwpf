<UserControl x:Class="WpfCompanyApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:conv="clr-namespace:WpfCompanyApp.Converters"
              xmlns:Release="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release" 
             mc:Ignorable="d"  >

    <!-- ============= STYLES ============= -->
    <UserControl.Resources>

        <!-- STYLE GỐC CHO CÁC NÚT LỆNH -->
        <Style x:Key="CommandButtonBaseStyle" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Padding" Value="15,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- START: xám khi không chạy, xanh sáng khi RUNNING -->
        <Style x:Key="StartButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.CurrentState}" Value="Running">
                    <Setter Property="Background" Value="#00E676"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- STOP: xám khi máy không dừng, đỏ sáng khi IDLE -->
        <Style x:Key="StopButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.CurrentState}" Value="Idle">
                    <Setter Property="Background" Value="#FF1744"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- HOME: chỉ xanh khi đang Stop/Idle và robot thực sự ở HomePose -->
        <Style x:Key="HomeButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Data.CurrentState}" Value="Idle"/>
                        <Condition Binding="{Binding Data.IsRobotAtHome}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1E88E5"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- PAUSE: xám khi không tạm dừng, vàng sáng khi PAUSED -->
        <Style x:Key="PauseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.CurrentState}" Value="Paused">
                    <Setter Property="Background" Value="#FFC400"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- RESET: vàng khi đang xử lý, xám khi đã xử lý xong -->
        <Style x:Key="ResetButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.IsResetProcessing}" Value="True">
                    <Setter Property="Background" Value="#FFC400"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShutdownButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.CurrentState}" Value="Idle">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RestartButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#E65100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Data.CurrentState}" Value="Idle">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ô PHÔI: TRỐNG = XÁM, CÓ PHÔI = XANH -->
        <Style x:Key="SlotCellStyle" TargetType="Border">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#2C2F33"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#00C853"/>
                    <Setter Property="BorderBrush" Value="#00E676"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <conv:MachineLogForegroundConverter x:Key="MachineLogForeground"/>
        <!-- STYLE CHO NÚT CHỌN JOB / CAMERA -->
        <Style x:Key="SwitchViewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <!-- CHỮ TRẮNG -->
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Background" Value="#2C2F33"/>
            <Setter Property="BorderBrush" Value="#3C3F46"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37474F"/>
                            </Trigger>

                            <!-- Press -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#455A64"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="JobActiveButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SwitchViewButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJobViewVisible}" Value="True">
                    <Setter Property="Background" Value="#00E676"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00C853"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CameraActiveButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SwitchViewButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJobViewVisible}" Value="False">
                    <Setter Property="Background" Value="#00E676"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#00C853"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="JobCameraButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CommandButtonBaseStyle}">
            <Setter Property="Background" Value="#00A86B"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJobViewVisible}" Value="False">
                    <Setter Property="Background" Value="#1565C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ===== CLEAR BUTTON STYLE ===== -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="BorderThickness" Value="0"/>

            <!-- QUAN TRỌNG -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                            <!-- KHÔNG PADDING -->
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E53935"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </UserControl.Resources>

    <!-- 🌌 NỀN TỔNG THỂ -->
    <Border Background="#20232A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="220"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsJobViewVisible}" Value="False">
                                    <Setter Property="Height" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <!-- 🟩 MAIN AREA -->
            <!-- ============= MAIN CONTENT ============= -->
            <Grid Grid.Row="0" Margin="10,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44*"/>
                    <RowDefinition Height="215*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/>
                    <!-- Nhóm 1: Vận hành -->

                    <!-- Nhóm 2: Khu vực phôi -->
                    <ColumnDefinition Width="3*"/>
                    <!-- Nhóm 3: Chọn Job -->
                </Grid.ColumnDefinitions>

                <!-- ========== NHÓM 1: VẬN HÀNH ========== -->
                <Border Grid.Column="0"
        Margin="10,10,10,0"
        CornerRadius="10"
        Background="#252830"
        BorderBrush="#3C3F46"
        BorderThickness="1" Grid.RowSpan="2">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                       Text="Vận hành"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#E0E0E0"
                       VerticalAlignment="Bottom"/>

                            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Bottom"
                        Margin="15,0,0,2">

                                <TextBlock Text="{Binding SelectedJob.JobName, TargetNullValue='(No job selected)'}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#00E676" 
                           Margin="0,0,10,0"/>

                                <TextBlock Text="{Binding HomeData}"
                           FontSize="13"
                           Foreground="#B0B0B0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Grid.RowSpan="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Width="340"
                              Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="147"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="147"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Start"
                                    Command="{Binding StartCommand}"
                                    Style="{StaticResource StartButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Stop"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource StopButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Home"
                                    Command="{Binding HomeCommand}"
                                    Style="{StaticResource HomeButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource ResetButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Pause"
                                    Command="{Binding PauseCommand}"
                                    Style="{StaticResource PauseButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Width="147"
                                    Height="68"
                                    FontSize="40"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{Binding JobCameraButtonText}"
                                    Command="{Binding ToggleJobCameraCommand}"
                                    Style="{StaticResource JobCameraButtonStyle}"
                                    Margin="0,9"/>
                            <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Width="147"
                                    Height="36"
                                    VerticalAlignment="Bottom"
                                    FontSize="18"
                                    Content="Restart"
                                    Command="{Binding RestartCommand}"
                                    Style="{StaticResource RestartButtonStyle}"
                                    Margin="0,9,0,10"/>
                            <Button Grid.Row="3"
                                    Grid.Column="2"
                                    Width="147"
                                    Height="36"
                                    VerticalAlignment="Bottom"
                                    FontSize="18"
                                    Content="Shutdown"
                                    Command="{Binding ShutdownCommand}"
                                    Style="{StaticResource ShutdownButtonStyle}"
                                    Margin="0,9,0,10"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- ========== NHÓM 2: CHỌN JOB ========== -->
                <!-- ========== NHÓM 3: CHỌN JOB ========== -->
                <Border Grid.Column="1"
                    Margin="10,10,10,0"
                    CornerRadius="10"
                    Background="#252830"
                    BorderBrush="#3C3F46"
                    BorderThickness="1" Grid.RowSpan="2">

                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Nút -->
                            <RowDefinition Height="*"/>
                            <!-- Nội dung -->
                        </Grid.RowDefinitions>

                        <!-- ===== HEADER BUTTON ===== -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== RIGHT: STATUS INFO ===== -->
                            <Border Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="#1E1E1E"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            TextElement.FontSize="14">

                                    <!-- Instant Cycle -->
                                    <TextBlock Text="Inst:"
                       Foreground="#CCCCCC"
                       Margin="0,0,5,0"/>
                                    <Border Background="#FFE0B2" Padding="6,2" CornerRadius="4">
                                        <TextBlock Text="{Binding Data.InstantCycleTime, StringFormat={}{0:0.##} s}"
                           Foreground="#000"
                           FontWeight="Bold"/>
                                    </Border>

                                    <!-- Average Cycle -->
                                    <TextBlock Text="Avg:"
                       Foreground="#CCCCCC"
                       Margin="15,0,5,0"/>
                                    <Border Background="#FFE0B2" Padding="6,2" CornerRadius="4">
                                        <TextBlock Text="{Binding Data.AverageCycleTime, StringFormat={}{0:0.##} s}"
                           Foreground="#000"
                           FontWeight="Bold"/>
                                    </Border>

                                    <!-- Basket 1 -->
                                    <TextBlock Text="  Basket 1:"
                       Foreground="#CCCCCC"
                       Margin="15,0,5,0"/>
                                    <Border Background="#FFE0B2" Padding="6,2" CornerRadius="4">
                                        <TextBlock Text="{Binding Data.Basket1Count, StringFormat={}{0:0}}"
                           Foreground="#000"
                           FontWeight="Bold"/>
                                    </Border>

                                    <!-- Basket 2 -->
                                    <TextBlock Text="  Basket 2:"
                       Foreground="#CCCCCC"
                       Margin="15,0,5,0"/>
                                    <Border Background="#FFE0B2" Padding="6,2" CornerRadius="4">
                                        <TextBlock Text="{Binding Data.Basket2Count, StringFormat={}{0:0}}"
                           Foreground="#000"
                           FontWeight="Bold"/>
                                    </Border>


                                    <!-- ===== TIME + COUNT + CLEAR (NEW) ===== -->


                                    <!-- Time -->
                                    <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Time:"
                   Foreground="#CCCCCC"
                   Margin="0,0,5,5"/>

                                    <Border 
                            Grid.Column="1"
                            Background="#FFE0B2"
                            Padding="6,2"
                            CornerRadius="4"
                           >
                                        <TextBlock Text="{Binding Data.CycleTimeDisplay}"
                       Foreground="#000"
                       FontWeight="Bold"/>
                                    </Border>

                                    <!-- Count -->
                                    <TextBlock 
                                       Grid.Column="0"
                                       Text="Count:"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,5,0"/>

                                    <Border 
                                        Grid.Column="1"
                                        Background="#FFE0B2"
                                        Padding="6,2"
                                        CornerRadius="4">
                                        <TextBlock Text="{Binding Data.CycleCount, StringFormat={}{0:0}}"
                                           Foreground="#000"
                                           FontWeight="Bold"/>
                                    </Border>

                                    <!-- Clear -->
                                    <Button Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="3"
                                    Content="Clear"
                                    Margin="10,0,0,0"
                                    Command="{Binding ClearCycleCommand}"
                                    Style="{StaticResource ClearButtonStyle}"/>


                                </StackPanel>
                            </Border>
                        </Grid>


                        <!-- ===== CONTENT ===== -->
                        <Grid Grid.Row="1">

                            <!-- JOB GRID -->
                            <DataGrid x:Name="JobsGrid"
          ItemsSource="{Binding ActiveJobs}"
          SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
          PreviewMouseLeftButtonDown="JobsGrid_PreviewMouseLeftButtonDown"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          Background="#2C2F33"
          Foreground="#E0E0E0"
          RowBackground="#2C2F33"
          AlternatingRowBackground="#32363F"
          BorderThickness="0"
          GridLinesVisibility="None"
          HeadersVisibility="Column"
          FontSize="20">

                                <DataGrid.Resources>

                                    <!-- Header style -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#333"/>
                                        <Setter Property="Foreground" Value="#EEE"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Height" Value="28"/>
                                    </Style>

                                    <!-- Row style -->
                                    <Style TargetType="DataGridRow">

                                        <Setter Property="Background" Value="#2F343F"/>
                                        <Setter Property="Foreground" Value="#EEE"/>

                                        <Style.Triggers>

                                            <!-- Row được click chọn -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FF9800"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>

                                            <!-- Job đang active -->
                                            <DataTrigger Binding="{Binding IsActiveJob}" Value="True">
                                                <Setter Property="Background" Value="#007ACC"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                                    <DataGridTextColumn Header="H1" Binding="{Binding H1}" Width="0.5*"/>
                                    <DataGridTextColumn Header="H2" Binding="{Binding H2}" Width="0.5*"/>
                                    <DataGridTextColumn Header="H3" Binding="{Binding H3}" Width="0.5*"/>
                                    <DataGridTextColumn Header="R"
                                                        Binding="{Binding R}"
                                                        Width="0.5*"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Job Time"
                                    Binding="{Binding DatetimeJob, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="*"/>
                                </DataGrid.Columns>

                            </DataGrid>


                            <!-- CAMERA -->
                            <Release:VmRenderControl
                                x:Name="vmRenderControl1"
                                 ModuleSource="{Binding ModuleSource}"
                                Panel.ZIndex="10"
                                Opacity="{Binding IsCameraViewVisible, Converter={StaticResource BoolToOpacity}}"
                                IsHitTestVisible="{Binding IsCameraViewVisible}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </Border>


            </Grid>

            <!-- 🟨 LOG AREA (giữ nguyên) -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsJobViewVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10,5,10,5">
                    <TextBlock Text="Machine Log" FontWeight="Bold" FontSize="16" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                    <Border Background="#0E1117" CornerRadius="6" Padding="5">
                        <ListBox ItemsSource="{Binding MachineLog}"
                                 Height="170"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Background="#0E1117"
                                 Foreground="#00FF88">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Converter={StaticResource MachineLogForeground}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,5,10,5">
                    <TextBlock Text="Robot History (last 1000 lines):"
                               FontWeight="Bold" FontSize="16" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                    <Border Background="#0E1117" CornerRadius="6" Padding="5">
                        <ListBox ItemsSource="{Binding RobotHistory}"
                                 FontSize="14"
                                 Background="#0E1117"
                                 Foreground="#00FF88"
                                 MaxHeight="170"
                                 Height="170"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{Binding Converter={StaticResource MachineLogForeground}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
